PORT=5000
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/pos_db
JWT_SECRET=super-secret-random-256bit-key-change-in-production
JWT_EXPIRES_IN=8h
NODE_ENV=development

# Allowed frontend origins. In production this must point at your Vercel app.
# Multiple origins are comma-separated (useful for production + preview URLs):
# CLIENT_URL=https://pos-shop.vercel.app,https://pos-shop-git-main-you.vercel.app
CLIENT_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email (optional) — used only by the "forgot password" OTP flow.
#
# Without this the app runs normally; the forgot-password endpoint simply
# answers EMAIL_NOT_CONFIGURED and tells the user to ask a manager.
#
# TWO channels are supported. HTTP is preferred, because hosts like Railway
# block outbound SMTP ports entirely (the connection just times out).
#
# ── Option 1 (recommended): an HTTP email API over HTTPS ──
# Works on Railway, Render and anywhere else. Brevo is the easiest to start
# with: free 300 emails/day, and it only needs you to verify a single sender
# address (no domain required).
#
#   EMAIL_API_PROVIDER=brevo
#   EMAIL_API_KEY=xkeysib-...            # Brevo -> SMTP & API -> API Keys
#
# Resend also works: EMAIL_API_PROVIDER=resend with EMAIL_API_KEY=re_...
#
# SMTP_USER is the "from" address and SMTP_FROM_NAME its display name.
#   SMTP_USER=alfa131431@gmail.com
#   SMTP_FROM_NAME=Unique Home Textile
#
# ── Option 2: plain SMTP ──
# Only on a host that allows SMTP. Gmail needs 2-Step Verification and an App
# Password from https://myaccount.google.com/apppasswords — a normal Gmail
# password will NOT work.
#
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=the-16-character-app-password
#   SMTP_FROM=Unique Home Textile <youraddress@gmail.com>
# ---------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Where password reset codes are delivered. Leave unset to use each user's own
# email address instead.
# PASSWORD_RESET_EMAIL=alfa131431@gmail.com

# ---------------------------------------------------------------------------
# Database backups
#
# A full snapshot (every collection) is written as a single JSON file. Take one
# on demand from the Backup page in the app (or `npm run db -- backup`); an
# automatic one runs every day at 02:00 and the newest 7 are kept.
#
# In production BACKUP_DIR defaults to <uploads>/backups — i.e. inside the
# host's persistent volume (Railway mounts it at /app/uploads, Render at
# .../backend/uploads) — so snapshots survive a redeploy. In development it
# defaults to <backend>/backups. Set BACKUP_DIR here to override, e.g.
# BACKUP_DIR=/app/uploads/backups
#
# The uploads folder is served as public static files, but /uploads/backups is
# deliberately blocked (see src/index.ts), so snapshots are only reachable
# through the authenticated /api/v1/backups API.
# ---------------------------------------------------------------------------
# BACKUP_DIR=/app/uploads/backups
# BACKUP_AUTO_ENABLED=true
# BACKUP_CRON=0 2 * * *
# BACKUP_RETENTION=7

