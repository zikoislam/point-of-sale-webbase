# Production environment for a self-hosted backend (copy to backend/.env).
# Generate the secret with:  openssl rand -hex 32

NODE_ENV=production
PORT=5000

# MongoDB — a local server on the VPS, or a MongoDB Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27017/pos_db

JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
JWT_EXPIRES_IN=8h

# The public HTTPS origin of the site (no trailing slash). Comma-separate
# several origins if needed (e.g. www + apex).
CLIENT_URL=https://your-domain.com

# ---- SaaS subscription / licensing (optional — see backend/.env.example) ----
# SUBSCRIPTION_ENFORCED=true
# SUBSCRIPTION_DEFAULT_GRACE_DAYS=7
# SUBSCRIPTION_DEFAULT_TRIAL_DAYS=14
# SUBSCRIPTION_WARN_DAYS=15

# ---- Backups (optional) ----
# BACKUP_DIR=/var/www/pos/backend/uploads/backups
# BACKUP_AUTO_ENABLED=true
# BACKUP_CRON=0 2 * * *
# BACKUP_RETENTION=7

# ---- Email for the forgot-password OTP (optional) ----
# EMAIL_API_PROVIDER=brevo
# EMAIL_API_KEY=
# SMTP_USER=
# SMTP_FROM_NAME=
