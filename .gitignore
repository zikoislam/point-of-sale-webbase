# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Desktop app build output. dist-electron-tmp is used when a locked app.asar in
# dist-electron forces a build into a different folder.
dist-electron/
dist-electron-tmp/
build/
build-verify/

# Portable MongoDB server fetched for offline mode (binary, not source)
electron/mongodb/

# License signing key. private.pem is the master secret: anyone holding it can
# mint valid licenses, so it must never be committed or packed into an installer.
tools/license-generator/keys/
tools/license-generator/issued.csv

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.test
.env*.local

# parcel-bundler cache (https://parceljs.org/)
.cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# OS metadata
.DS_Store
Thumbs.db

# Uploaded images (logos, avatars)
backend/uploads/*
!backend/uploads/.gitkeep

# Local database backups produced by backend/scripts/db-tool.js
backend/backups/

# Business spreadsheets — customer ledgers, supplier lists and Excel lock files
# hold real customer names and balances, so they must not reach the repository.
*.xlsx
*.xls
~$*

# Stray empty repository (contains only a .git with no commits). It blocks
# `git add -A` because git tries to record it as a submodule.
untitled-project/
