# Local development — talk to the backend directly on this machine.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Production (set these in the Vercel project settings, not in this file).
#
# The API lives on a different domain (Railway) from the site (Vercel), which
# made the auth cookie a third-party cookie. Browsers — iOS Safari by default —
# refuse to store those, so signing in appeared to work and then bounced straight
# back to the login page. next.config.mjs now proxies /api/*, /uploads/* and
# /socket.io/* through this domain, and the frontend calls the API on its own
# origin, which keeps the cookie first-party:
#
#   NEXT_PUBLIC_API_URL=/api/v1
#
# Leave NEXT_PUBLIC_SOCKET_URL unset in production. The socket client falls back
# to window.location.origin, which keeps its handshake cookie first-party too.
#
# API_PROXY_TARGET only needs setting if the backend moves somewhere other than
# https://pos-api-production-f0f5.up.railway.app
